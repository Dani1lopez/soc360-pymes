# Build context for the Python images (Dockerfile targets: worker, runtime).
#
# Without this file the context is ~1.4 GB: .venv (194M), venv (182M),
# frontend/node_modules (383M) and a raw PostgreSQL data directory (72M).
#
# The images copy only these paths, so everything else can be excluded:
#   uv.lock, pyproject.toml, .python-version
#   app/, migrations/, alembic.ini, entrypoint.sh, gunicorn_conf.py
#   scripts/seed_db.py

.git
.github

# Python environments and caches
.venv
venv
__pycache__
**/__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.pyright_cache

# Local data, secrets and tooling output
.env
.env*
docker/postgres-data
docker/redis-data
odd
openspec
docs
tests
frontend
docker

# Agent and tooling artifacts: prompts, plans, transcripts and local agent state
# never belong in an image layer.
.codegraph
.claude
.pi
.atl
.sdd
.commandcode
.windsurf
.cursor
.opencode
.worktrees
.gga

# Secret-class files: keys, bundles and credential stores are never copied into
# an image even if someone drops one in the working tree.
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
secrets/
credentials*.json
.netrc
.pgpass

# scripts/ is excluded except for the seed script the runtime image ships: that
# script is what gives a fresh demo stack somebody to log in as. It refuses to
# run outside development, so carrying just that file is safe; operational
# scripts stay out of the build context.
scripts/*
!scripts/seed_db.py

# Local demonstration stacks and their fixtures: the images do not need them,
# and docker/demo-target has its own context.
docker-compose*.yml
compose*.yml
*.md
*.log
.gitignore
.dockerignore
