# Build context for the frontend image (context: ./frontend).
#
# The image needs package.json, pnpm-lock.yaml, src/, index.html and the build
# configuration. Everything generated or installed locally stays out.

node_modules
dist
.vite
coverage
test-results
playwright-report
blob-report

# No environment file is needed: the SPA always calls the API through a
# relative path and Vite only exposes variables prefixed with VITE_PUBLIC_.
.env
.env*

*.log
.DS_Store
