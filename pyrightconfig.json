{
  "include": [
    "app",
    "tests"
  ],
  "exclude": [
    "**/__pycache__",
    ".venv",
    "migrations/versions",
    ".pi",
    ".worktrees"
  ],
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.12",
  "typeCheckingMode": "basic",
  "useLibraryCodeForTypes": false,
  "reportMissingImports": "error",
  "reportMissingTypeStubs": "warning"
}
